            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "x-resource-type", "value": "bus_id" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"number\": \"BUS-999\",\n  \"registrationNumber\": \"DHK-TEST-999\",\n  \"operatorName\": \"Test Operator\",\n  \"totalSeats\": 40\n}" },
            "url": { "raw": "{{baseUrl}}/buses", "host": ["{{baseUrl}}"], "path": ["buses"] }
          }
        }
      ]
    },
    {
      "name": "Schedules",
      "item": [
        {
          "name": "List Schedules",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
