          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "x-resource-type", "value": "schedule_id" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"busId\": \"{{bus_id}}\",\n  \"routeId\": \"{{route_id}}\",\n  \"departureTime\": \"08:00:00\",\n  \"arrivalTime\": \"13:00:00\",\n  \"daysOfWeek\": 127,\n  \"effectiveFrom\": \"2026-08-09\",\n  \"fareAmount\": 800\n}" },
            "url": { "raw": "{{baseUrl}}/schedules", "host": ["{{baseUrl}}"], "path": ["schedules"] }
          }
        }
      ]
    },
    {
      "name": "Trips",
      "item": [
        {
          "name": "Search Trips",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": { "raw": "{{baseUrl}}/schedules/trips?travelDate=2026-08-09", "host": ["{{baseUrl}}"], "path": ["schedules", "trips"], "query": [{ "key": "travelDate", "value": "2026-08-09" }] }
          }
        }
      ]
    },
    {
      "name": "Booking",
      "item": [
        {
          "name": "Get Available Seats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": { "raw": "{{baseUrl}}/booking/schedules/{{schedule_id}}/seats?travelDate=2026-08-09", "host": ["{{baseUrl}}"], "path": ["booking", "schedules", "{{schedule_id}}", "seats"], "query": [{ "key": "travelDate", "value": "2026-08-09" }] }
          }
        },
        {
          "name": "Sell Ticket",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{staff_token}}" },
              { "key": "x-expected-schema", "value": "TicketDto" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"scheduleId\": \"{{schedule_id}}\",\n  \"seatId\": \"{{seat_id}}\",\n  \"travelDate\": \"2026-08-09\",\n  \"passengerName\": \"John Doe\",\n  \"mobileNumber\": \"01700000000\",\n  \"fareAmount\": 800,\n  \"paymentMethod\": 0\n}" },
            "url": { "raw": "{{baseUrl}}/booking/tickets", "host": ["{{baseUrl}}"], "path": ["booking", "tickets"] }
          }
        },
        {
          "name": "Search Tickets",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{staff_token}}" }],
            "url": { "raw": "{{baseUrl}}/booking/tickets?pageNumber=1&pageSize=20", "host": ["{{baseUrl}}"], "path": ["booking", "tickets"], "query": [{ "key": "pageNumber", "value": "1" }, { "key": "pageSize", "value": "20" }] }
          }
        },
        {
          "name": "My Tickets (Customer)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customer_token}}" }],
            "url": { "raw": "{{baseUrl}}/booking/my-tickets", "host": ["{{baseUrl}}"], "path": ["booking", "my-tickets"] }
          }
        },
        {
          "name": "Cancel Ticket",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{staff_token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"reason\": \"Customer request\"\n}" },
            "url": { "raw": "{{baseUrl}}/booking/tickets/{{ticket_id}}/cancel", "host": ["{{baseUrl}}"], "path": ["booking", "tickets", "{{ticket_id}}", "cancel"] }
          }
        }
      ]
    },
