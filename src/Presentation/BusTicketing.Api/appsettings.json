{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "PostgreSql"
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=bus_ticketing;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Secret": "REPLACE_WITH_A_SECRET_OF_AT_LEAST_32_CHARACTERS_VIA_ENV_VAR",
    "Issuer": "BusTicketingSystem",
    "Audience": "BusTicketingSystem.Clients",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200", "http://localhost:61893" ]
  },
  "SeedData": {
    "Enabled": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  }
}
