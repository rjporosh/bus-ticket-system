{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "PostgreSql"
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=bus_ticketing;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Secret": "REPLACE_WITH_A_SECRET_OF_AT_LEAST_32_CHARACTERS_VIA_ENV_VAR",
    "Issuer": "BusTicketingSystem",
    "Audience": "BusTicketingSystem.Clients",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200", "http://localhost:4201", "http://localhost:61893" ]
  },
  "SeedData": {
    "Enabled": true
  },
  "Email": {
    "SmtpHost": "smtp.example.com",
    "SmtpPort": 587,
    "SmtpUsername": "",
    "SmtpPassword": "",
    "FromEmail": "noreply@busticketing.example",
    "FromName": "Bus Ticketing System",
    "EnableSsl": true,
    "EnableNotifications": false
  },
  "Sms": {
    "Provider": "None",
    "EnableNotifications": false,
    "Twilio": {
      "AccountSid": "",
      "AuthToken": "",
      "FromNumber": ""
    },
    "GsmGateway": {
      "BaseUrl": "",
      "ApiKey": "",
      "SenderId": ""
    }
  },
  "PaymentGateway": {
    "Provider": "Mock",
    "EnableRealGateway": false,
    "Bkash": {
      "BaseUrl": "https://tokenized.sandbox.bka.sh/v1.2.0-beta",
      "Username": "",
      "Password": "",
      "AppKey": "",
      "AppSecret": "",
      "MerchantId": "",
      "WebhookPort": 5000
    },
    "Nagad": {
      "BaseUrl": "https://sandbox.nagad.com.bd/api/v2",
      "MerchantId": "",
      "PublicKey": "",
      "PrivateKey": ""
    },
    "CardGateway": {
      "BaseUrl": "",
      "ApiKey": "",
      "MerchantId": ""
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  }
}
